{
  "name": "moqi-jev-loop",
  "version": "0.1.0",
  "description": "The /JevLoop control panel for moqi: gates and API key from dsh-jev-loop, rendered through moqi's tuiHost seam.",
  "type": "module",
  "license": "MIT",
  "author": "JWE24-code <292770342+JWE24-code@users.noreply.github.com>",
  "homepage": "https://github.com/JWE24-code/moqi-jev-loop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JWE24-code/moqi-jev-loop.git",
    "directory": "packages/moqi-jev-loop"
  },
  "bugs": "https://github.com/JWE24-code/moqi-jev-loop/issues",
  "keywords": [
    "moqi",
    "moqi-plugin",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "jev",
    "typesafe"
  ],
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types tests/panel-smoke.ts",
    "prepublishOnly": "npm run build && npm run typecheck && npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "dsh-jev-loop": "^0.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
