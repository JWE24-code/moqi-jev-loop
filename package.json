{
  "name": "moqi-jev-loop",
  "version": "0.1.0",
  "private": true,
  "description": "Jev (TypeSafe System One) gates for the DeepSeek Harness agent loop, and the /JevLoop control panel that moqi renders for them.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "link-harness": "node scripts/link-harness.mjs",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "install-profile": "node scripts/install-profile.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
